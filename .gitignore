__pycache__/
*.pyc
presets/*-copy.json
.venv/
.claude/
.DS_Store

# Downloaded module assets (model files etc.), fetched + hash-checked by the sync
*.task

# UI: node_modules is disposable, but ui/dist is committed on purpose so
# `python run.py` works without a Node toolchain (see ui/README.md).
ui/node_modules/

# Desktop app build output (PyInstaller) - not ui/dist, which is committed.
/build/
/dist/

# Sources and sinks live in their own repo (sensor-patchbay-modules) and are
# installed from the catalog (Browse modules in the UI, `install <name>` in the
# console, or `run.py --install <name>`). Only the plugin base classes stay here.
/sources/*/
/sinks/*/
# Resolved from whichever modules are installed, so it differs per machine.
/patchbay.lock
.catalog-cache.json
