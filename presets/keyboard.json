{
  "name": "keyboard",
  "requires": [
    {"id": "joycon", "kind": "source", "types": ["joycon", "mock"]},
    {"id": "hid", "kind": "sink", "types": ["dryrun", "hid"]}
  ],
  "connections": [
    {
      "id": "k_d",
      "source": "joycon/tilt.roll",
      "sink": "hid/key.d",
      "chain": [{"type": "schmitt", "params": {"on": 20.0, "off": 12.0}}]
    },
    {
      "id": "k_a",
      "source": "joycon/tilt.roll",
      "sink": "hid/key.a",
      "chain": [{"type": "schmitt", "params": {"on": -20.0, "off": -12.0}}]
    },
    {
      "id": "k_w",
      "source": "joycon/tilt.pitch",
      "sink": "hid/key.w",
      "chain": [{"type": "schmitt", "params": {"on": -20.0, "off": -12.0}}]
    },
    {
      "id": "k_s",
      "source": "joycon/tilt.pitch",
      "sink": "hid/key.s",
      "chain": [{"type": "schmitt", "params": {"on": 20.0, "off": 12.0}}]
    },
    {"id": "k_space", "source": "joycon/btn.a", "sink": "hid/key.space", "chain": []},
    {
      "id": "k_esc",
      "source": "joycon/accel.mag",
      "sink": "hid/key.esc",
      "chain": [
        {"type": "threshold", "params": {"level": 2.5, "mode": "gt"}},
        {"type": "debounce", "params": {"ms": 400.0}},
        {"type": "hold", "params": {"ms": 60.0}}
      ]
    },
    {"id": "k_preset", "source": "joycon/btn.home", "sink": "sys/preset.cycle", "chain": []}
  ]
}
